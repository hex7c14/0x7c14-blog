---

<a href={href} class="win-nav-item" aria-current={active ? 'page' : undefined}>
  <svg
    class="win-nav-icon"
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    set:html={icons[icon] ?? icons.doc}
  />
  <span data-i18n={dataI18n}>{label}</span>
</a>
