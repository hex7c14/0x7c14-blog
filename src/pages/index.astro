---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import SettingsCard from '@/components/ui/SettingsCard.astro';
import Avatar from '@/components/ui/Avatar.astro';
import AboutReadme from '@/content/about.mdx';
import { profileConfig, siteConfig } from '@/config';
import { getLocale, type Lang } from '@/i18n';

const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const posts = allPosts
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .map((p) => ({ slug: p.slug, title: p.data.title }));

const lang = (Astro.url.searchParams.get('lang') as Lang) || siteConfig.lang;
const t = getLocale(lang);
const now = new Date();
const initialTime = new Intl.DateTimeFormat(lang, { hour: '2-digit', minute: '2-digit' }).format(now);
const initialDay = new Intl.DateTimeFormat(lang, { day: 'numeric' })
  .formatToParts(now)
  .find((part) => part.type === 'day')?.value ?? '';
const initialMonth = new Intl.DateTimeFormat(lang, { month: 'long', year: 'numeric' }).format(now);
const initialWeekday = new Intl.DateTimeFormat(lang, { weekday: 'long' }).format(now);
const initialDate = new Intl.DateTimeFormat(lang, {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  weekday: 'long',
}).format(now);
const initialTimeZone = new Intl.DateTimeFormat(lang, { timeZoneName: 'short' })
  .formatToParts(now)
  .find((part) => part.type === 'timeZoneName')?.value ?? '';

const userIcon = `<svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>`;
const calendarIcon = `<svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M16 3v4M8 3v4M3 10h18"/></svg>`;
const githubIcon = `<svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" fill="currentColor"><path d="M12 .5C5.37.5 0 5.78 0 12.292c0 5.211 3.438 9.63 8.205 11.188.6.111.82-.254.82-.567 0-.28-.01-1.022-.015-2.005-3.338.711-4.042-1.582-4.042-1.582-.546-1.361-1.335-1.725-1.335-1.725-1.087-.731.084-.716.084-.716 1.205.082 1.838 1.215 1.838 1.215 1.07 1.803 2.809 1.282 3.495.981.108-.763.417-1.282.76-1.577-2.665-.295-5.466-1.309-5.466-5.827 0-1.287.465-2.339 1.235-3.164-.135-.298-.54-1.497.105-3.121 0 0 1.005-.316 3.3 1.209.96-.262 1.98-.392 3-.398 1.02.006 2.04.136 3 .398 2.28-1.525 3.285-1.209 3.285-1.209.645 1.624.24 2.823.12 3.121.765.825 1.23 1.877 1.23 3.164 0 4.53-2.805 5.527-5.475 5.817.42.354.81 1.077.81 2.182 0 1.578-.015 2.846-.015 3.229 0 .309.21.678.825.56C20.565 21.917 24 17.495 24 12.292 24 5.78 18.627.5 12 .5z"/></svg>`;
---

<BaseLayout posts={posts} lang={lang}>
  <div class="win-page">
    <h1 class="win-page-title" data-i18n="home.title">{t.home.title}</h1>

    <SettingsCard
      title={profileConfig.name}
      description={profileConfig.bio}
      icon={userIcon}
      class="win-home-profile"
    >
      <div slot="action" class="win-author-actions">
        <Avatar src={profileConfig.avatar} alt={profileConfig.name} size={72} />
      </div>
    </SettingsCard>

    <section class="win-home-section">
      <div class="win-home-grid">
        <div class="win-settings-card win-home-time">
          <div class="win-home-calendar-icon" set:html={calendarIcon} aria-hidden="true"></div>
          <div class="win-home-calendar">
            <div class="win-home-calendar-month" data-home-month>{initialMonth}</div>
            <div class="win-home-calendar-day" data-home-day>{initialDay}</div>
            <div class="win-home-calendar-weekday" data-home-weekday>{initialWeekday}</div>
          </div>
          <div class="win-home-calendar-details">
            <div class="win-home-calendar-date" data-home-date>{initialDate}</div>
            <div class="win-home-clock">
              <time datetime={now.toISOString()} data-home-clock>{initialTime}</time>
              <span class="win-home-timezone" data-home-timezone>{initialTimeZone}</span>
            </div>
          </div>
        </div>
        <SettingsCard
          href="https://github.com/hex7c14"
          title="GitHub"
          description={t.home.githubDescription}
          icon={githubIcon}
          class="win-home-link"
          external={true}
        />
      </div>
    </section>

    <section class="win-home-about" aria-labelledby="home-about-title">
      <article class="win-home-about-card prose-win">
        <AboutReadme />
      </article>
    </section>

  </div>
</BaseLayout>

<script is:inline define:vars={{ lang }}>
  (() => {
    const time = document.querySelector('[data-home-clock]');
    const date = document.querySelector('[data-home-date]');
    const day = document.querySelector('[data-home-day]');
    const month = document.querySelector('[data-home-month]');
    const weekday = document.querySelector('[data-home-weekday]');
    const timeZone = document.querySelector('[data-home-timezone]');
    if (!time || !date || !day || !month || !weekday || !timeZone) return;

    const updateClock = () => {
      const now = new Date();
      const locale = document.documentElement.getAttribute('data-lang') || lang;
      const formatter = new Intl.DateTimeFormat(locale, {
        hour: '2-digit',
        minute: '2-digit',
      });
      time.textContent = formatter.format(now);
      time.dateTime = now.toISOString();
      date.textContent = new Intl.DateTimeFormat(locale, {
        year: 'numeric',
        month: 'long',
        day: 'numeric',
        weekday: 'long',
      }).format(now);
      day.textContent = new Intl.DateTimeFormat(locale, { day: 'numeric' })
        .formatToParts(now)
        .find((part) => part.type === 'day')?.value ?? '';
      month.textContent = new Intl.DateTimeFormat(locale, { month: 'long', year: 'numeric' }).format(now);
      weekday.textContent = new Intl.DateTimeFormat(locale, { weekday: 'long' }).format(now);
      timeZone.textContent = new Intl.DateTimeFormat(locale, { timeZoneName: 'short' })
        .formatToParts(now)
        .find((part) => part.type === 'timeZoneName')?.value ?? '';
    };

    updateClock();
    window.setInterval(updateClock, 30_000);
  })();
</script>

<style>
  .win-page {
    max-width: 920px;
  }

  .win-page :global(.win-page-title) {
    margin-bottom: 28px;
    font-size: clamp(32px, 4vw, 40px);
  }

  .win-home-section {
    margin-top: 28px;
  }

  .win-author-actions {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .win-home-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  .win-home-grid :global(.win-settings-card) {
    min-height: 172px;
    padding: 24px;
  }

  .win-home-grid :global(.win-settings-card-title) {
    font-size: 20px;
  }

  .win-home-grid :global(.win-settings-card-desc) {
    font-size: 15px;
  }

  .win-page :global(.win-home-profile) {
    min-height: 132px;
    gap: 20px;
    padding: 24px;
  }

  .win-page :global(.win-home-profile .win-settings-card-title) {
    font-size: 22px;
  }

  .win-page :global(.win-home-profile .win-settings-card-desc) {
    font-size: 16px;
  }

  .win-home-time {
    display: grid;
    grid-template-columns: 32px minmax(148px, 0.85fr) minmax(0, 1.15fr);
    align-items: center;
    gap: 20px;
  }

  .win-home-calendar-icon {
    align-self: start;
    width: 28px;
    height: 28px;
    color: var(--win-accent);
  }

  .win-home-calendar-icon :global(svg) {
    width: 28px;
    height: 28px;
  }

  .win-home-calendar {
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    grid-template-areas: "month month" "day weekday";
    align-items: baseline;
    column-gap: 12px;
    row-gap: 4px;
    padding-right: 20px;
    border-right: 1px solid var(--win-divider);
  }

  .win-home-calendar-month {
    grid-area: month;
    color: var(--win-text-secondary);
    font-size: 14px;
  }

  .win-home-calendar-day {
    grid-area: day;
    color: var(--win-text-primary);
    font-size: 44px;
    font-variant-numeric: tabular-nums;
    font-weight: 600;
    letter-spacing: -0.05em;
    line-height: 1;
    white-space: nowrap;
  }

  .win-home-calendar-weekday {
    grid-area: weekday;
    color: var(--win-accent);
    font-size: 13px;
    white-space: nowrap;
  }

  .win-home-calendar-details {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    min-width: 0;
  }

  .win-home-calendar-date {
    color: var(--win-text-secondary);
    font-size: 14px;
  }

  .win-home-clock {
    display: flex;
    align-items: baseline;
    gap: 10px;
    color: var(--win-text-primary);
    font-size: clamp(32px, 4vw, 44px);
    font-variant-numeric: tabular-nums;
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .win-home-timezone {
    color: var(--win-text-secondary);
    font-size: 13px;
    font-weight: 400;
    letter-spacing: 0;
  }

  .win-home-about {
    margin-top: 36px;
  }

  .win-home-about-card {
    padding: clamp(24px, 4vw, 36px);
    border: 1px solid var(--win-stroke-card);
    border-radius: var(--win-radius-card);
    background: var(--win-card-bg);
    backdrop-filter: blur(24px) saturate(140%);
    -webkit-backdrop-filter: blur(24px) saturate(140%);
  }

  @media (max-width: 640px) {
    .win-home-grid {
      grid-template-columns: 1fr;
    }

    .win-home-grid :global(.win-settings-card) {
      min-height: 148px;
      padding: 20px;
    }

    .win-home-clock {
      font-size: 36px;
    }

    .win-home-time {
      grid-template-columns: 24px minmax(0, 1fr);
      gap: 14px;
    }

    .win-home-calendar-icon,
    .win-home-calendar-icon :global(svg) {
      width: 24px;
      height: 24px;
    }

    .win-home-calendar {
      padding-right: 0;
      border-right: 0;
    }

    .win-home-calendar-details {
      grid-column: 2;
      padding-top: 14px;
      border-top: 1px solid var(--win-divider);
    }

  }
</style>
