---
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { siteConfig } from '@/config';
import { getLocale, type Lang } from '@/i18n';

export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
};

const { post } = Astro.props;
const { Content, headings } = await post.render();

const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const posts = allPosts
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .map((p) => ({ slug: p.slug, title: p.data.title }));

const lang = (post.data.lang as Lang) || siteConfig.lang;
const t = getLocale(lang);
---

<BaseLayout posts={posts} lang={lang} title={post.data.title} description={post.data.description}>
  <div class="win-post-layout">
    <article class="win-post">
      <header class="win-post-header">
        <h1 class="win-post-title">{post.data.title}</h1>
        <time class="win-post-date" datetime={post.data.date.toISOString()}>
          {t.home.publishedAt}: {post.data.date.toLocaleDateString(lang)}
        </time>
      </header>

      <div class="win-post-content">
        <div class="prose-win">
          <Content />
        </div>
      </div>

      <a href="/" class="win-btn" data-i18n="post.backToHome">
        {t.post.backToHome}
      </a>
    </article>

    {
      headings.length > 0 && (
        <aside class="win-post-outline">
          <nav aria-label="文章大纲">
            <h2 class="win-post-outline-title">文章大纲</h2>
            <ol>
              <span class="win-post-outline-indicator" aria-hidden="true"></span>
              {headings.map((heading) => (
                <li
                  data-depth={heading.depth}
                  style={`--outline-level: ${Math.max(heading.depth - 1, 0)}`}
                >
                  <a href={`#${heading.slug}`}>{heading.text}</a>
                </li>
              ))}
            </ol>
          </nav>
        </aside>
      )
    }
  </div>
  <script is:inline>
    (() => {
      const outline = document.querySelector('.win-post-outline');
      const list = outline?.querySelector('ol');
      const indicator = outline?.querySelector('.win-post-outline-indicator');
      const links = Array.from(outline?.querySelectorAll('a[href^="#"]') ?? []);
      if (!list || !indicator || !links.length) return;

      const headingLinks = links.map((link) => ({
        link,
        heading: document.getElementById(decodeURIComponent(link.hash.slice(1))),
      })).filter((item) => item.heading);
      if (!headingLinks.length) return;

      let frame = 0;
      const setActive = (activeLink) => {
        links.forEach((link) => {
          if (link === activeLink) link.setAttribute('aria-current', 'location');
          else link.removeAttribute('aria-current');
        });

        const linkRect = activeLink.getBoundingClientRect();
        const listRect = list.getBoundingClientRect();
        indicator.style.height = Math.max(linkRect.height - 8, 16) + 'px';
        indicator.style.transform = 'translateY(' + (linkRect.top - listRect.top + 4) + 'px)';
        indicator.classList.add('is-visible');
      };

      const updateFromScroll = () => {
        frame = 0;
        let active = headingLinks[0];
        for (const item of headingLinks) {
          if (item.heading.getBoundingClientRect().top <= 160) active = item;
          else break;
        }
        setActive(active.link);
      };

      headingLinks.forEach(({ link }) => {
        link.addEventListener('click', () => setActive(link));
      });

      const scheduleUpdate = () => {
        if (!frame) frame = requestAnimationFrame(updateFromScroll);
      };

      setActive(headingLinks[0].link);
      window.addEventListener('scroll', scheduleUpdate, { passive: true });
      window.addEventListener('resize', scheduleUpdate);
      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          indicator.classList.add('is-ready');
          updateFromScroll();
        });
      });
    })();
  </script>
</BaseLayout>

<style>
  .win-post-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 240px;
    gap: clamp(24px, 3vw, 40px);
    align-items: start;
    width: min(100%, 1680px);
    margin: 0 auto;
  }

  .win-post {
    min-width: 0;
  }

  .win-post-header {
    margin-bottom: 28px;
    padding: 0 0 20px;
    border-bottom: 1px solid var(--win-divider);
  }

  .win-post-title {
    font-size: clamp(28px, 4vw, 36px);
    font-weight: 600;
    color: var(--win-text-primary);
    margin: 0 0 12px;
    line-height: 1.18;
    letter-spacing: -0.03em;
  }

  .win-post-date {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    padding: 2px 8px;
    border: 1px solid var(--win-stroke-default);
    border-radius: var(--win-radius-control);
    background: var(--win-control-fill-default);
    font-size: var(--win-font-caption);
    color: var(--win-text-secondary);
  }

  .win-post-content {
    margin: 0 0 24px;
    padding: clamp(24px, 3vw, 40px);
    border: 1px solid var(--win-stroke-card);
    border-radius: var(--win-radius-card);
    background: var(--win-card-bg);
    backdrop-filter: blur(24px) saturate(140%);
    -webkit-backdrop-filter: blur(24px) saturate(140%);
  }

  .win-post-outline {
    position: sticky;
    top: 28px;
    max-height: calc(100vh - 56px);
    overflow-y: auto;
    padding: 18px 16px;
    border: 1px solid var(--win-stroke-card);
    border-radius: var(--win-radius-card);
    background: var(--win-card-bg);
    backdrop-filter: blur(24px) saturate(140%);
    -webkit-backdrop-filter: blur(24px) saturate(140%);
    scrollbar-width: thin;
  }

  .win-post-outline-title {
    margin: 0 0 12px;
    color: var(--win-text-primary);
    font-size: var(--win-font-body-strong);
    font-weight: 600;
  }

  .win-post-outline nav {
    position: relative;
  }

  .win-post-outline ol {
    position: relative;
    display: grid;
    gap: 2px;
    margin: 0;
    padding: 0 0 0 10px;
    list-style: none;
  }

  .win-post-outline-indicator {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 1;
    width: 3px;
    height: 24px;
    border-radius: 0 2px 2px 0;
    background: var(--win-accent);
    opacity: 0;
    pointer-events: none;
    transition:
      transform 0.38s cubic-bezier(0.34, 1.56, 0.64, 1),
      height 0.3s var(--win-ease),
      background-color 0.18s var(--win-ease),
      opacity 0.18s var(--win-ease);
  }

  .win-post-outline-indicator.is-visible {
    opacity: 1;
  }

  .win-post-outline-indicator:not(.is-ready) {
    transition: none;
  }

  .win-post-outline li {
    margin-left: calc(var(--outline-level, 0) * 12px);
  }

  .win-post-outline a {
    display: block;
    padding: 6px 8px;
    border-radius: var(--win-radius-control);
    color: var(--win-text-secondary);
    line-height: 1.45;
    text-decoration: none;
    transition:
      color 0.25s var(--win-ease),
      background-color 0.25s var(--win-ease);
  }

  .win-post-outline li[data-depth="1"] a {
    color: var(--win-text-primary);
    font-size: 14px;
    font-weight: 600;
  }

  .win-post-outline li[data-depth="2"] a {
    color: var(--win-text-secondary);
    font-size: 13px;
    font-weight: 500;
  }

  .win-post-outline li[data-depth="3"] a {
    color: var(--win-text-secondary);
    font-size: 12px;
    font-weight: 400;
  }

  .win-post-outline li[data-depth="4"] a,
  .win-post-outline li[data-depth="5"] a,
  .win-post-outline li[data-depth="6"] a {
    color: var(--win-text-tertiary);
    font-size: 11px;
    font-weight: 400;
  }

  .win-post-outline a:hover,
  .win-post-outline a[aria-current="location"] {
    color: var(--win-accent-text);
    background: var(--win-subtle-secondary);
  }

  .win-post-outline a:focus-visible {
    outline: 2px solid var(--win-accent);
    outline-offset: 1px;
  }

  @media (prefers-reduced-motion: reduce) {
    .win-post-outline-indicator,
    .win-post-outline a {
      transition: none;
    }
  }

  @media (prefers-reduced-transparency: reduce) {
    .win-post-content,
    .win-post-outline {
      background: var(--win-card-bg-solid);
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }
  }

  @media (max-width: 1100px) {
    .win-post-layout {
      grid-template-columns: minmax(0, 1fr);
    }

    .win-post-outline {
      position: static;
      max-height: none;
      order: -1;
    }

    .win-post-outline ol {
      display: flex;
      flex-wrap: wrap;
      gap: 4px;
      padding-left: 0;
    }

    .win-post-outline li {
      margin-left: 0;
    }

    .win-post-outline-indicator {
      display: none;
    }
  }

  @media (max-width: 600px) {
    .win-post-content {
      padding: 20px 16px;
    }
  }
</style>
