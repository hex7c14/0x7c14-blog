---
import '@/styles/global.css';
import { siteConfig } from '@/config';
import { getLocale, locales, type Lang } from '@/i18n';
import Sidebar from '@/components/layout/Sidebar.astro';

interface Props {
  title?: string;
  description?: string;
  posts: { slug: string; title: string }[];
  lang?: Lang;
}

const {
  title,
  description = siteConfig.subtitle,
  posts,
  lang: defaultLang = siteConfig.lang,
} = Astro.props;

const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const fullTitle = title ? `${title} · ${siteConfig.title}` : siteConfig.title;
const t = getLocale(defaultLang);
---

<!doctype html>
<html lang={defaultLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/favicon.png" />

    <!-- 防闪烁：在渲染前设置主题与语言 -->
    <script is:inline>
      (function () {
        try {
          var savedTheme = localStorage.getItem('theme');
          var theme = savedTheme;
          if (!theme) {
            theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          }
          document.documentElement.setAttribute('data-theme', theme);

          var savedLang = localStorage.getItem('lang');
          if (savedLang) {
            document.documentElement.setAttribute('data-lang', savedLang);
          }

          var root = document.documentElement;
          var wallpaperUrl = new URL(localStorage.getItem('blog-wallpaper-url') || '/bg.jpg', location.href);
          if (wallpaperUrl.protocol === 'http:' || wallpaperUrl.protocol === 'https:') {
            root.style.setProperty('--win-wallpaper-image', 'url("' + wallpaperUrl.href + '")');
            var cachedAccent = JSON.parse(localStorage.getItem('wallpaper-accent-cache') || 'null');
            if (cachedAccent && cachedAccent.url === wallpaperUrl.href && cachedAccent.properties) {
              Object.keys(cachedAccent.properties).forEach(function (property) {
                root.style.setProperty(property, cachedAccent.properties[property]);
              });
            }
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <div class="win-app">
      <Sidebar posts={posts} currentPath={currentPath} lang={defaultLang} theme={'light'} />
      <main class="win-main">
        <slot />
      </main>
    </div>

    <!-- i18n 文本替换 + 控件状态同步 -->
    <script is:inline define:vars={{ defaultLang, t, locales }}>
      (function () {
        var html = document.documentElement;
        var lang = html.getAttribute('data-lang') || defaultLang;
        var dict = locales[lang] || locales[defaultLang];

        // 替换所有 data-i18n 文本
        document.querySelectorAll('[data-i18n]').forEach(function (el) {
          var key = el.getAttribute('data-i18n');
          var val = key.split('.').reduce(function (o, k) { return o && o[k]; }, dict);
          if (val) el.textContent = val;
        });

        // 同步主题开关
        var theme = html.getAttribute('data-theme') || 'light';
        var themeToggle = document.getElementById('theme-toggle');
        if (themeToggle) {
          themeToggle.checked = theme === 'dark';
        }
      })();
    </script>

    <!-- Reveal 效果：鼠标追踪 + 主题/语言切换交互 -->
    <script is:inline>
      (function () {
        // ---- 页面入场动画：稳定标记 win-entered，不依赖导航 active 状态 ----
        var main = document.querySelector('.win-main');
        if (main) {
          // 双 rAF 确保浏览器已应用初始态(transform/opacity)后再触发过渡
          requestAnimationFrame(function () {
            requestAnimationFrame(function () {
              main.classList.add('win-entered');
            });
          });
        }

        // 侧栏折叠状态与按钮辅助信息同步
        var sidebarToggle = document.querySelector('[data-sidebar-toggle]');
        if (sidebarToggle) {
          var root = document.documentElement;
          var sidebar = document.querySelector('.win-sidebar');
          var isHomePage = location.pathname.replace(/\/+$/, '') === '';
          var isPostPage = location.pathname.indexOf('/posts/') === 0;

          root.removeAttribute('data-sidebar-collapsed');

          var syncSidebarToggle = function () {
            var collapsed = root.getAttribute('data-sidebar-collapsed') === 'true';
            sidebarToggle.setAttribute('aria-expanded', String(!collapsed));
            sidebarToggle.setAttribute('title', collapsed ? 'Expand navigation' : 'Collapse navigation');
          };

          var setSidebarCollapsed = function (collapsed) {
            root.setAttribute('data-sidebar-collapsed', String(collapsed));
            syncSidebarToggle();
          };

          syncSidebarToggle();
          sidebarToggle.addEventListener('click', function () {
            setSidebarCollapsed(root.getAttribute('data-sidebar-collapsed') !== 'true');
          });

          if (isHomePage) {
            var scrollFrame = 0;
            var userScrollIntent = false;

            window.addEventListener('wheel', function () {
              userScrollIntent = true;
            }, { passive: true });
            window.addEventListener('touchmove', function () {
              userScrollIntent = true;
            }, { passive: true });
            window.addEventListener('keydown', function (event) {
              if (['ArrowDown', 'ArrowUp', 'PageDown', 'PageUp', 'Home', 'End', ' '].indexOf(event.key) !== -1) {
                userScrollIntent = true;
              }
            });

            window.addEventListener('scroll', function () {
              if (!userScrollIntent || scrollFrame) return;
              scrollFrame = window.requestAnimationFrame(function () {
                setSidebarCollapsed(window.scrollY > 48);
                scrollFrame = 0;
              });
            }, { passive: true });
          } else if (isPostPage && sidebar) {
            var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
            window.setTimeout(function () {
              setSidebarCollapsed(true);
            }, reduceMotion ? 0 : 420);
          }
        }

        // ---- 导航指示器：单一蓝条滑动到激活项 ----
        (function () {
          var nav = document.querySelector('.win-sidebar-nav');
          var indicator = nav ? nav.querySelector('.win-nav-indicator') : null;
          var activeItem = nav ? nav.querySelector('.win-nav-item[aria-current="page"], .win-nav-item.is-active') : null;
          if (!nav || !indicator || !activeItem) return;

          var navRect = nav.getBoundingClientRect();
          var itemRect = activeItem.getBoundingClientRect();
          // 目标位置：相对 nav 顶部的偏移 + 8px 内边距(匹配原指示条上下各留 8px)
          var targetTop = itemRect.top - navRect.top + 8;
          var targetHeight = itemRect.height - 16;

          // 从上一次位置(跨页面)或顶部开始，先无过渡定位
          var lastTop = parseFloat(sessionStorage.getItem('win-nav-indicator-top') || '0');
          indicator.style.transition = 'none';
          indicator.style.transform = 'translateY(' + lastTop + 'px)';
          indicator.style.height = targetHeight + 'px';

          // 下一帧开启过渡并滑到目标位置
          requestAnimationFrame(function () {
            requestAnimationFrame(function () {
              indicator.style.transition = '';
              indicator.style.transform = 'translateY(' + targetTop + 'px)';
              indicator.classList.add('is-visible');
              sessionStorage.setItem('win-nav-indicator-top', String(targetTop));
            });
          });
        })();

        // Reveal：卡片微光跟随鼠标
        document.querySelectorAll('a.win-settings-card').forEach(function (card) {
          card.addEventListener('mousemove', function (e) {
            var rect = card.getBoundingClientRect();
            card.style.setProperty('--win-reveal-x', (e.clientX - rect.left) + 'px');
            card.style.setProperty('--win-reveal-y', (e.clientY - rect.top) + 'px');
          });
        });

        // 主题切换
        var themeToggle = document.getElementById('theme-toggle');
        if (themeToggle) {
          themeToggle.addEventListener('change', function () {
            var theme = this.checked ? 'dark' : 'light';
            document.documentElement.setAttribute('data-theme', theme);
            localStorage.setItem('theme', theme);
          });
        }
      })();
    </script>

    <script is:inline>
      (function () {
        var root = document.documentElement;
        var accentProperties = [
          '--win-accent-auto-light',
          '--win-accent-secondary-auto-light',
          '--win-accent-tertiary-auto-light',
          '--win-accent-auto-dark',
          '--win-accent-secondary-auto-dark',
          '--win-accent-tertiary-auto-dark',
          '--win-accent-text-auto-light',
          '--win-accent-text-auto-dark',
          '--win-text-on-accent-auto-light',
          '--win-text-on-accent-auto-dark',
          '--win-accent-rgb-light',
          '--win-accent-rgb-dark',
        ];
        var currentWallpaper = '';
        var requestId = 0;

        function hslToRgb(h, s, l) {
          var chroma = (1 - Math.abs(2 * l - 1)) * s;
          var section = h / 60;
          var secondary = chroma * (1 - Math.abs(section % 2 - 1));
          var offset = l - chroma / 2;
          var channels = section < 1 ? [chroma, secondary, 0]
            : section < 2 ? [secondary, chroma, 0]
            : section < 3 ? [0, chroma, secondary]
            : section < 4 ? [0, secondary, chroma]
            : section < 5 ? [secondary, 0, chroma]
            : [chroma, 0, secondary];
          return channels.map(function (channel) {
            return Math.round((channel + offset) * 255);
          });
        }

        function luminance(rgb) {
          var channels = rgb.map(function (value) {
            var normalized = value / 255;
            return normalized <= 0.04045
              ? normalized / 12.92
              : Math.pow((normalized + 0.055) / 1.055, 2.4);
          });
          return channels[0] * 0.2126 + channels[1] * 0.7152 + channels[2] * 0.0722;
        }

        function contrastRatio(first, second) {
          var values = [luminance(first), luminance(second)].sort(function (a, b) { return b - a; });
          return (values[0] + 0.05) / (values[1] + 0.05);
        }

        function accessibleTextColor(hue, saturation, background, start, direction) {
          for (var lightness = start; lightness >= 0 && lightness <= 1; lightness += direction * 0.01) {
            var rgb = hslToRgb(hue, saturation, lightness);
            if (contrastRatio(rgb, background) >= 4.5) {
              return 'hsl(' + hue + ' ' + Math.round(saturation * 100) + '% ' + Math.round(lightness * 100) + '%)';
            }
          }
          return direction < 0 ? '#000000' : '#ffffff';
        }

        function setColor(rgb) {
          return 'rgb(' + rgb.join(' ') + ')';
        }

        function applyAccent(hue, saturation) {
          var sat = Math.max(0.52, Math.min(0.78, saturation));
          var light = hslToRgb(hue, sat, 0.42);
          var lightSecondary = hslToRgb(hue, sat, 0.49);
          var lightTertiary = hslToRgb(hue, sat, 0.34);
          var dark = hslToRgb(hue, sat, 0.68);
          var darkSecondary = hslToRgb(hue, sat, 0.76);
          var darkTertiary = hslToRgb(hue, sat, 0.60);
          var lightSurface = [243, 243, 243];
          var darkSurface = [32, 32, 32];
          var lightForeground = contrastRatio(light, [0, 0, 0]) > contrastRatio(light, [255, 255, 255])
            ? '#000000' : '#ffffff';
          var darkForeground = contrastRatio(dark, [0, 0, 0]) > contrastRatio(dark, [255, 255, 255])
            ? '#000000' : '#ffffff';

          var properties = {
            '--win-accent-auto-light': setColor(light),
            '--win-accent-secondary-auto-light': setColor(lightSecondary),
            '--win-accent-tertiary-auto-light': setColor(lightTertiary),
            '--win-accent-auto-dark': setColor(dark),
            '--win-accent-secondary-auto-dark': setColor(darkSecondary),
            '--win-accent-tertiary-auto-dark': setColor(darkTertiary),
            '--win-accent-text-auto-light': accessibleTextColor(hue, sat, lightSurface, 0.42, -1),
            '--win-accent-text-auto-dark': accessibleTextColor(hue, sat, darkSurface, 0.68, 1),
            '--win-text-on-accent-auto-light': lightForeground,
            '--win-text-on-accent-auto-dark': darkForeground,
            '--win-accent-rgb-light': light.join(', '),
            '--win-accent-rgb-dark': dark.join(', '),
          };

          Object.keys(properties).forEach(function (property) {
            root.style.setProperty(property, properties[property]);
          });
          try {
            localStorage.setItem('wallpaper-accent-cache', JSON.stringify({
              url: currentWallpaper,
              properties: properties,
            }));
          } catch (error) {
            console.warn('Could not cache the wallpaper accent color.', error);
          }
        }

        function resetAccent() {
          accentProperties.forEach(function (property) { root.style.removeProperty(property); });
          try {
            localStorage.removeItem('wallpaper-accent-cache');
          } catch (error) {
            console.warn('Could not clear the cached wallpaper accent color.', error);
          }
        }

        function readDominantColor(image) {
          var canvas = document.createElement('canvas');
          canvas.width = 64;
          canvas.height = 64;
          var context = canvas.getContext('2d', { willReadFrequently: true });
          if (!context) throw new Error('Canvas 2D context is unavailable.');

          context.drawImage(image, 0, 0, canvas.width, canvas.height);
          var pixels = context.getImageData(0, 0, canvas.width, canvas.height).data;
          var bins = Array.from({ length: 24 }, function () {
            return { score: 0, hueX: 0, hueY: 0, saturation: 0, count: 0 };
          });

          for (var i = 0; i < pixels.length; i += 4) {
            if (pixels[i + 3] < 128) continue;
            var red = pixels[i] / 255;
            var green = pixels[i + 1] / 255;
            var blue = pixels[i + 2] / 255;
            var max = Math.max(red, green, blue);
            var min = Math.min(red, green, blue);
            var delta = max - min;
            var lightness = (max + min) / 2;
            if (delta < 0.04 || lightness < 0.12 || lightness > 0.88) continue;

            var saturation = delta / (1 - Math.abs(2 * lightness - 1));
            var hue;
            if (max === red) hue = 60 * (((green - blue) / delta) % 6);
            else if (max === green) hue = 60 * ((blue - red) / delta + 2);
            else hue = 60 * ((red - green) / delta + 4);
            if (hue < 0) hue += 360;

            var bin = bins[Math.floor(hue / 15) % bins.length];
            var weight = saturation * (1 - Math.abs(lightness - 0.5) * 0.5);
            bin.score += weight;
            bin.hueX += Math.cos(hue * Math.PI / 180) * weight;
            bin.hueY += Math.sin(hue * Math.PI / 180) * weight;
            bin.saturation += saturation * weight;
            bin.count += weight;
          }

          var dominant = bins.reduce(function (best, bin) {
            return bin.score > best.score ? bin : best;
          }, { score: 0, hueX: 0, hueY: 0, saturation: 0, count: 0 });
          if (!dominant.count) return null;

          var hue = Math.atan2(dominant.hueY, dominant.hueX) * 180 / Math.PI;
          if (hue < 0) hue += 360;
          return { hue: hue, saturation: dominant.saturation / dominant.count };
        }

        function updateAccent() {
          var background = window.getComputedStyle(document.body, '::before').backgroundImage;
          var match = background.match(/url\(["']?(.*?)["']?\)/);
          if (!match || match[1] === currentWallpaper) return;

          currentWallpaper = match[1];
          var thisRequest = ++requestId;
          var image = new Image();
          image.crossOrigin = 'anonymous';
          image.onload = function () {
            if (thisRequest !== requestId) return;
            try {
              var color = readDominantColor(image);
              if (color) applyAccent(color.hue, color.saturation);
              else resetAccent();
            } catch (error) {
              resetAccent();
              console.warn('Could not sample the wallpaper accent color. Ensure the image allows canvas access.', error);
            }
          };
          image.onerror = function () {
            if (thisRequest !== requestId) return;
            resetAccent();
            console.warn('Could not load wallpaper for accent-color sampling:', currentWallpaper);
          };
          image.src = match[1];
        }

        window.setBlogWallpaper = function (source) {
          var url = new URL(source, window.location.href);
          if (url.protocol !== 'http:' && url.protocol !== 'https:') {
            throw new TypeError('Wallpaper URL must use HTTP or HTTPS.');
          }
          try {
            localStorage.setItem('blog-wallpaper-url', url.href);
          } catch (error) {
            console.warn('Could not persist the selected wallpaper.', error);
          }
          root.style.setProperty('--win-wallpaper-image', 'url("' + url.href + '")');
          requestAnimationFrame(updateAccent);
        };

        var observer = new MutationObserver(updateAccent);
        observer.observe(root, { attributes: true, attributeFilter: ['style'] });
        window.addEventListener('wallpaperchange', updateAccent);
        updateAccent();
      })();
    </script>
  </body>
</html>

<style is:global>
  .win-app {
    display: flex;
    min-height: 100vh;
    background: transparent;
  }

  .win-main {
    flex: 1;
    min-width: 0;
    padding: 32px 48px;
    overflow-x: clip;
    /* 用 token 变量：浅/深色由 :root/[data-theme=dark] 在 fluent-tokens.css 切换 */
    background: var(--win-main-bg);
  }

  @media (max-width: 768px) {
    .win-main {
      padding: 16px;
    }
  }
</style>
